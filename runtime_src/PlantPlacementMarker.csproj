<Project Sdk="Microsoft.NET.Sdk">

  <!-- 种植位置标识：托管运行时程序集。
       刻意不用 Godot.NET.Sdk（要联网还原包 + 源码生成器）；只用 Godot 普通 API
       和游戏程序集（PlantsVsZombies.dll）的公开成员。
       ★ AssemblyName 必须是本 Mod 自己的唯一名字（安卓要求唯一），打包时产物改名成
         Runtime/ModAssembly.dll（mod.json 的 runtimeAssembly 是硬编码字面量）。 -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>JTYPlantPlacementMarker</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <GodotRefDir Condition="'$(GodotRefDir)' == ''"></GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
